diff -ruN a/lib/newsletter-presend.ts b/lib/newsletter-presend.ts
--- a/lib/newsletter-presend.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/newsletter-presend.ts	2026-10-16 10:41:49.137039822 +0000
@@ -0,0 +1,33 @@
+// 발송 전 품질 게이트 (2026-10-16). 전체 발송 직전에 서버에서 실행한다.
+// 1) issue_date 는 "발송하는 날의 뉴질랜드 날짜"(YYYY.MM.DD)와 같아야 한다 — #27 은 초안 작성일(목)이 남아 10.15 로 나갔다.
+// 2) 프리헤더 임시값(빈칸·':)' 등 5자 미만) 금지
+// 3) Local Guide 카드 칸: 빈 칸 또는 제목·본문·링크 중 일부만 찬 칸 금지
+// 4) 승인 해시: 편집자가 테스트 메일로 확인한 본문(서버 렌더 HTML)의 해시와 지금 발송할 본문 해시가 같아야 한다.
+import { createHash } from 'crypto';
+import type { MailrangiNotesData } from '@/lib/newsletter-template';
+
+export function nzDateString(d: Date = new Date()): string {
+  const p = new Intl.DateTimeFormat('en-CA', { timeZone: 'Pacific/Auckland', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(d);
+  const g = (t: string) => p.find((x) => x.type === t)?.value ?? '';
+  return `${g('year')}.${g('month')}.${g('day')}`;
+}
+
+export function contentHash(html: string): string {
+  return createHash('sha256').update(html, 'utf8').digest('hex').slice(0, 16);
+}
+
+export function presendIssues(data: MailrangiNotesData, opts: { now?: Date; html: string; approvedHash?: string }): string[] {
+  const issues: string[] = [];
+  const today = nzDateString(opts.now);
+  if ((data.issueDate ?? '').trim() !== today) issues.push(`발행일(issue_date) "${data.issueDate}" 이 오늘 뉴질랜드 날짜 ${today} 와 다릅니다. 발행일을 고치고 테스트 메일을 다시 보내 확인하세요.`);
+  if ((data.preheader ?? '').trim().length < 5) issues.push(`프리헤더가 비었거나 임시값("${data.preheader ?? ''}")입니다.`);
+  (data.locals ?? []).forEach((c, i) => {
+    const t = (c.title ?? '').trim(), b = (c.body ?? '').trim(), l = (c.link ?? '').trim();
+    if (!t && !b && !l) issues.push(`Local Guide 카드 ${i + 1}번 칸이 비어 있습니다(빈 칸이 메일에 그대로 나갑니다). 채우거나 칸을 지우세요.`);
+    else if (!t || !b) issues.push(`Local Guide 카드 ${i + 1}번에 제목 또는 본문이 없습니다.`);
+  });
+  const h = contentHash(opts.html);
+  if (!opts.approvedHash) issues.push('승인 확인이 없습니다. 먼저 테스트 메일을 보내 최종본을 확인하세요.');
+  else if (opts.approvedHash !== h) issues.push(`테스트 메일로 확인한 본문(${opts.approvedHash})과 지금 발송할 본문(${h})이 다릅니다. 수정 후 테스트 메일을 다시 보내 확인하세요.`);
+  return issues;
+}
