# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/.next.bak2/
/.next.old/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code (session files)
.claude/scheduled_tasks.lock

# playwright & screenshots
.playwright-mcp/
*.png
!public/icon-*.png
!public/icons/*.png
!public/favicon.ico
!docs/qa/**/*.png
!mockups/**/*.png
*.jpg.tmp

# Temp QA scripts (auto-generated)
/dom_check.mjs
/fix_qa.mjs
/get_user.mjs
/playwright_script.mjs
/run_qa*.mjs

# Local backups
*.bak
# 데이터 마이그레이션이 남기는 원본 백업 — 기사 본문 전문이 들어 있어 커밋하지 않는다
qa-reports/*-backup-*.json

# Secrets / ephemeral auth
magiclink.txt
*.magiclink

# QA screenshots (jpeg not covered by *.png rule above)
qa-screenshots/

# Codex local config — contains a personal access token, must never be committed
.codex/config.toml
